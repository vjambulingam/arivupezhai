---
import { getUrl } from '../utils/url.js';

const homeUrl = getUrl('/');
const thirukkuralUrl = getUrl('/book/thirukkural');
const logoUrl = getUrl('arivupezhai-logo-transparent.png');
const themes = [
  { id: 'bronze', name: 'செப்பேடு' },
  { id: 'night', name: 'இரவுக் கூடம்' },
  { id: 'mist', name: 'குறிஞ்சிக் குளிர்' },
];
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-[var(--bg-page)]/90 border-b border-[var(--border-subtle)] transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18">
      
      <!-- Brand Logo & Title -->
      <a href={homeUrl} class="group flex items-center space-x-3 max-[359px]:space-x-2 transition-opacity hover:opacity-90">
        <div class="h-10 max-[359px]:h-8 sm:h-11 flex items-center justify-center shrink-0 group-hover:scale-105 transition-transform">
          <img
            src={logoUrl}
            alt="அறிவுப்பேழை"
            class="h-10 max-[359px]:h-8 sm:h-11 w-auto max-w-[120px] object-contain"
            loading="eager"
          />
        </div>
        <div class="flex flex-col">
          <span class="font-tamil-serif font-bold text-xl max-[359px]:text-lg sm:text-2xl text-[var(--text-main)] tracking-tight">
            அறிவுப்பேழை
          </span>
          <span class="text-xs text-[var(--text-muted)] font-tamil-sans hidden sm:block">
            செவ்வியல் தமிழ் இணைய நூலகம்
          </span>
        </div>
      </a>

      <!-- Search Trigger Button -->
      <div class="flex-1 min-w-0 max-w-md mx-4 hidden sm:block">
        <button
          type="button"
          id="search-trigger-btn"
          class="w-full flex items-center justify-between px-3.5 py-2 text-sm rounded-xl bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-hover)] text-[var(--text-muted)] border border-[var(--border-subtle)] transition-all shadow-sm group"
        >
          <div class="flex items-center gap-2.5 truncate">
            <svg class="w-4 h-4 text-[var(--text-dim)] group-hover:text-[var(--accent-primary)] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span class="font-tamil-sans text-xs md:text-sm">நூல், ஆசிரியர், அதிகாரம் தேடுக...</span>
          </div>
          <kbd class="hidden md:inline-flex items-center gap-0.5 text-[10px] px-2 py-0.5 rounded bg-[var(--bg-muted)] border border-[var(--border-subtle)] font-mono text-[var(--text-dim)]">
            /
          </kbd>
        </button>
      </div>

      <!-- Navigation & Theme Switcher -->
      <div class="flex items-center gap-3 max-[359px]:gap-2">
        <nav class="hidden lg:flex items-center gap-1 font-tamil-sans text-sm font-medium">
          <a
            href={homeUrl}
            class="px-3 py-1.5 rounded-lg text-[var(--text-main)] hover:bg-[var(--bg-surface)] transition-colors"
          >
            நூல்கள்
          </a>
          <a
            href={thirukkuralUrl}
            class="px-3 py-1.5 rounded-lg text-[var(--text-main)] hover:bg-[var(--bg-surface)] transition-colors"
          >
            திருக்குறள்
          </a>
        </nav>

        <select
          class="theme-select hidden lg:block rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-3 py-2 font-tamil-sans text-sm text-[var(--text-main)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--border-focus)]"
          aria-label="வாசிப்பு வண்ணத்தைத் தேர்ந்தெடுக்கவும்"
        >
          {themes.map((theme) => <option value={theme.id}>{theme.name}</option>)}
        </select>

        <!-- Mobile Search Button -->
        <button
          type="button"
          id="mobile-search-btn"
          class="sm:hidden p-2 rounded-lg text-[var(--text-main)] hover:bg-[var(--bg-surface)] border border-[var(--border-subtle)]"
          aria-label="Search"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>

        <!-- Mobile Navigation Menu Button -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="lg:hidden p-2 rounded-lg text-[var(--text-main)] hover:bg-[var(--bg-surface)] border border-[var(--border-subtle)]"
          aria-label="Toggle Menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-[var(--border-subtle)] bg-[var(--bg-page)] px-4 py-3 space-y-2 font-tamil-sans">
    <a href={homeUrl} class="block px-3 py-2 rounded-lg text-[var(--text-main)] hover:bg-[var(--bg-surface)]">
      நூல்கள் (Library)
    </a>
    <a href={thirukkuralUrl} class="block px-3 py-2 rounded-lg text-[var(--text-main)] hover:bg-[var(--bg-surface)]">
      திருக்குறள் (Thirukkural)
    </a>
    <label class="flex items-center justify-between gap-3 px-3 py-2 text-sm text-[var(--text-main)]">
      <span>வாசிப்பு வண்ணம்</span>
      <select class="theme-select rounded-xl border border-[var(--border-subtle)] bg-[var(--bg-surface)] px-3 py-2 text-sm text-[var(--text-main)] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--border-focus)]">
        {themes.map((theme) => <option value={theme.id}>{theme.name}</option>)}
      </select>
    </label>
  </div>
</header>

<script>
  const themeSelects = document.querySelectorAll<HTMLSelectElement>('.theme-select');
  function syncThemeSelects() {
    const theme = document.documentElement.getAttribute('data-theme') || 'bronze';
    themeSelects.forEach((select) => { select.value = theme; });
  }
  syncThemeSelects();
  window.addEventListener('theme-changed', syncThemeSelects);
  themeSelects.forEach((select) => {
    select.addEventListener('change', () => {
      document.documentElement.setAttribute('data-theme', select.value);
      localStorage.setItem('arivupezhai_theme', select.value);
      window.dispatchEvent(new CustomEvent('theme-changed', { detail: select.value }));
    });
  });

  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Keyboard shortcut for search (/)
  window.addEventListener('keydown', (e) => {
    if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) {
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('open-search'));
    }
  });

  // Search trigger buttons
  const searchTriggerBtn = document.getElementById('search-trigger-btn');
  const mobileSearchBtn = document.getElementById('mobile-search-btn');
  const triggerSearch = () => window.dispatchEvent(new CustomEvent('open-search'));
  if (searchTriggerBtn) searchTriggerBtn.addEventListener('click', triggerSearch);
  if (mobileSearchBtn) mobileSearchBtn.addEventListener('click', triggerSearch);
</script>
