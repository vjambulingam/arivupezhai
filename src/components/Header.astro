---
import { getUrl } from '../utils/url.js';

const homeUrl = getUrl('/');
const thirukkuralUrl = getUrl('/book/thirukkural');
const palettesUrl = getUrl('/palettes');
---

<header class="sticky top-0 z-40 w-full backdrop-blur-md bg-[var(--bg-page)]/90 border-b border-[var(--border-subtle)] transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-18">
      
      <!-- Brand Logo & Title -->
      <a href={homeUrl} class="group flex items-center space-x-3 transition-opacity hover:opacity-90">
        <div class="w-10 h-10 rounded-xl bg-[var(--accent-primary)] flex items-center justify-center text-[var(--accent-contrast)] shadow-sm group-hover:scale-105 transition-transform">
          <span class="font-tamil-serif font-bold text-xl leading-none">அ</span>
        </div>
        <div class="flex flex-col">
          <span class="font-tamil-serif font-bold text-xl sm:text-2xl text-[var(--text-main)] tracking-tight">
            அறிவுப்பேழை
          </span>
          <span class="text-xs text-[var(--text-muted)] font-tamil-sans hidden sm:block">
            செவ்வியல் தமிழ் இணைய நூலகம்
          </span>
        </div>
      </a>

      <!-- Search Trigger Button -->
      <div class="flex-1 max-w-md mx-4 hidden sm:block">
        <button
          type="button"
          id="search-trigger-btn"
          class="w-full flex items-center justify-between px-3.5 py-2 text-sm rounded-xl bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-hover)] text-[var(--text-muted)] border border-[var(--border-subtle)] transition-all shadow-sm group"
        >
          <div class="flex items-center gap-2.5 truncate">
            <svg class="w-4 h-4 text-[var(--text-dim)] group-hover:text-[var(--accent-primary)] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <span class="font-tamil-sans text-xs md:text-sm">நூல், ஆசிரியர், அதிகாரம் தேடுக...</span>
          </div>
          <kbd class="hidden md:inline-flex items-center gap-0.5 text-[10px] px-2 py-0.5 rounded bg-[var(--bg-muted)] border border-[var(--border-subtle)] font-mono text-[var(--text-dim)]">
            /
          </kbd>
        </button>
      </div>

      <!-- Navigation & Theme Switcher -->
      <div class="flex items-center gap-3">
        <nav class="hidden md:flex items-center gap-1 font-tamil-sans text-sm font-medium">
          <a
            href={homeUrl}
            class="px-3 py-1.5 rounded-lg text-[var(--text-main)] hover:bg-[var(--bg-surface)] transition-colors"
          >
            நூல்கள்
          </a>
          <a
            href={thirukkuralUrl}
            class="px-3 py-1.5 rounded-lg text-[var(--text-main)] hover:bg-[var(--bg-surface)] transition-colors"
          >
            திருக்குறள்
          </a>
          <a
            href={palettesUrl}
            class="px-3 py-1.5 rounded-lg text-[var(--accent-primary)] font-semibold hover:bg-[var(--bg-surface)] transition-colors flex items-center gap-1.5"
          >
            <span class="w-2 h-2 rounded-full bg-[var(--accent-primary)]"></span>
            வண்ணத் தீம்கள்
          </a>
        </nav>

        <!-- Quick Theme Selector Pill -->
        <div class="flex items-center bg-[var(--bg-surface)] p-1 rounded-full border border-[var(--border-subtle)] shadow-inner" title="வாசிப்பு வண்ணத்தை மாற்றுக">
          <button
            type="button"
            data-set-theme="bronze"
            class="theme-btn w-6 h-6 rounded-full bg-[#F6F2EC] border border-[#AD5F1D] transition-transform hover:scale-110 active:scale-95"
            title="செப்பேடு (Temple Bronze)"
            aria-label="Bronze Theme"
          ></button>
          <button
            type="button"
            data-set-theme="night"
            class="theme-btn w-6 h-6 rounded-full bg-[#17181B] border border-[#343842] ml-1 transition-transform hover:scale-110 active:scale-95"
            title="இரவுக் கூடம் (Midnight Slate)"
            aria-label="Night Theme"
          ></button>
          <button
            type="button"
            data-set-theme="mist"
            class="theme-btn w-6 h-6 rounded-full bg-[#F0F4F8] border border-[#27567B] ml-1 transition-transform hover:scale-110 active:scale-95"
            title="குறிஞ்சிக் குளிர் (Cool Mountain Mist)"
            aria-label="Cool Mist Theme"
          ></button>
        </div>

        <!-- Mobile Search Button -->
        <button
          type="button"
          id="mobile-search-btn"
          class="sm:hidden p-2 rounded-lg text-[var(--text-main)] hover:bg-[var(--bg-surface)] border border-[var(--border-subtle)]"
          aria-label="Search"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
        </button>

        <!-- Mobile Navigation Menu Button -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="md:hidden p-2 rounded-lg text-[var(--text-main)] hover:bg-[var(--bg-surface)] border border-[var(--border-subtle)]"
          aria-label="Toggle Menu"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

      </div>
    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden border-t border-[var(--border-subtle)] bg-[var(--bg-page)] px-4 py-3 space-y-2 font-tamil-sans">
    <a href={homeUrl} class="block px-3 py-2 rounded-lg text-[var(--text-main)] hover:bg-[var(--bg-surface)]">
      நூல்கள் (Library)
    </a>
    <a href={thirukkuralUrl} class="block px-3 py-2 rounded-lg text-[var(--text-main)] hover:bg-[var(--bg-surface)]">
      திருக்குறள் (Thirukkural)
    </a>
    <a href={palettesUrl} class="block px-3 py-2 rounded-lg text-[var(--accent-primary)] font-semibold hover:bg-[var(--bg-surface)]">
      வண்ணத் தீம்கள் (Reading Themes)
    </a>
  </div>
</header>

<script>
  // Theme Switching functionality
  const themeButtons = document.querySelectorAll('.theme-btn');
  themeButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetTheme = btn.getAttribute('data-set-theme');
      if (targetTheme) {
        document.documentElement.setAttribute('data-theme', targetTheme);
        localStorage.setItem('arivupezhai_theme', targetTheme);
        window.dispatchEvent(new CustomEvent('theme-changed', { detail: targetTheme }));
      }
    });
  });

  // Mobile menu toggle
  const mobileMenuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  if (mobileMenuBtn && mobileMenu) {
    mobileMenuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
    });
  }

  // Keyboard shortcut for search (/)
  window.addEventListener('keydown', (e) => {
    if (e.key === '/' && !['INPUT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) {
      e.preventDefault();
      window.dispatchEvent(new CustomEvent('open-search'));
    }
  });

  // Search trigger buttons
  const searchTriggerBtn = document.getElementById('search-trigger-btn');
  const mobileSearchBtn = document.getElementById('mobile-search-btn');
  const triggerSearch = () => window.dispatchEvent(new CustomEvent('open-search'));
  if (searchTriggerBtn) searchTriggerBtn.addEventListener('click', triggerSearch);
  if (mobileSearchBtn) mobileSearchBtn.addEventListener('click', triggerSearch);
</script>
