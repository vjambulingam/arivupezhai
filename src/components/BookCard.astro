---
import { getUrl } from '../utils/url.js';

interface Props {
  book: {
    id: string;
    slug?: string;
    title_ta: string;
    title_en: string;
    author_ta: string;
    author_en: string;
    genre_ta: string;
    category_ta: string;
    subsections_label: string;
    featured_quote: string;
    description_ta: string;
    is_available: boolean;
    reading_minutes?: number;
    stats: {
      subsections: number;
      verses: number;
    };
    sections?: { id: string }[];
  };
}

const { book } = Astro.props;
const landingUrl = getUrl(`book/${book.slug ?? book.id}`);
const readerUrl = book.sections?.length ? getUrl(`book/${book.slug ?? book.id}/read/${book.sections[0].id}/`) : landingUrl;
---

<div class="group relative flex flex-col justify-between rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] p-6 transition-all duration-200 hover:shadow-xl hover:border-[var(--accent-primary)]/40 hover:-translate-y-1">
  
  <div>
    <!-- Top Metadata Badges -->
    <div class="flex items-center justify-between gap-2 mb-4">
      <div class="flex flex-wrap items-center gap-1.5">
        <span class="inline-flex items-center px-2.5 py-1 rounded-full text-xs font-medium font-tamil-sans bg-[var(--badge-bg)] text-[var(--badge-text)] border border-[var(--border-subtle)]">
          {book.genre_ta}
        </span>
        {book.is_available && book.reading_minutes != null && (
          <span class="inline-flex items-center px-2.5 py-1 rounded-full text-[11px] font-medium font-tamil-sans bg-[var(--bg-muted)] text-[var(--text-muted)]">
            சுமார் {book.reading_minutes} நிமிட வாசிப்பு
          </span>
        )}
      </div>

      {!book.is_available && (
        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-medium bg-[var(--bg-muted)] text-[var(--text-dim)]">
          விரைவில்
        </span>
      )}
    </div>

    <!-- Book Title & Author -->
    <a href={book.is_available ? landingUrl : undefined} class="block focus:outline-none">
      <h2 class="font-tamil-serif font-bold text-2xl sm:text-3xl text-[var(--text-main)] group-hover:text-[var(--accent-primary)] transition-colors leading-tight">
        {book.title_ta}
      </h2>
      <div class="flex items-center gap-2 mt-2 text-sm text-[var(--text-muted)] font-tamil-sans">
        <svg class="w-4 h-4 text-[var(--accent-primary)] flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z" />
        </svg>
        <span class="font-medium">{book.author_ta}</span>
        <span class="text-xs text-[var(--text-dim)]">({book.title_en})</span>
      </div>
    </a>

    <!-- Classical Quote / Snippet -->
    <div class="mt-4 p-3.5 rounded-xl bg-[var(--bg-page)]/70 border border-[var(--border-subtle)]/70">
      <p class="font-tamil-serif italic text-sm text-[var(--text-main)] leading-relaxed line-clamp-2">
        "{book.featured_quote}"
      </p>
    </div>

    <!-- Subsections Count Pill -->
    <div class="mt-4 flex items-center gap-2 text-xs text-[var(--text-muted)] font-tamil-sans">
      <svg class="w-4 h-4 text-[var(--text-dim)]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
      </svg>
      <span class="font-medium text-[var(--text-main)]">{book.subsections_label}</span>
    </div>
  </div>

  <!-- Touch Action Buttons -->
  <div class="mt-6 pt-4 border-t border-[var(--border-subtle)] flex items-center gap-3 font-tamil-sans">
    {book.is_available ? (
      <>
        <!-- Primary Action: Open Reader directly -->
        <a
          href={readerUrl}
          class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-[var(--accent-primary)] hover:bg-[var(--accent-hover)] text-[var(--accent-contrast)] text-sm font-semibold shadow-sm transition-all active:scale-95"
          title="நேரடியாக வாசிக்க"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          <span>நேரடியாக வாசிக்க</span>
        </a>

        <!-- Secondary Action: Open Dedicated Book Landing Page -->
        <a
          href={landingUrl}
          class="inline-flex items-center justify-center px-3.5 py-2.5 rounded-xl bg-[var(--bg-muted)] hover:bg-[var(--bg-surface-hover)] text-[var(--text-main)] text-sm font-medium border border-[var(--border-subtle)] transition-colors"
          title="அதிகாரங்கள் மற்றும் நூல் விபரம்"
        >
          <span>நூல் விபரம்</span>
        </a>
      </>
    ) : (
      <button
        disabled
        class="w-full inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-[var(--bg-muted)] text-[var(--text-dim)] text-sm font-medium cursor-not-allowed border border-[var(--border-subtle)]"
      >
        <span>அடுத்த பதிப்பில் வெளிவரும்</span>
      </button>
    )}
  </div>

</div>
