---
import { getUrl } from '../utils/url.js';
import { books } from '../utils/books';
const indexUrl = getUrl('search-index.json');
const tagCounts = new Map<string, number>();
for (const book of books) {
  for (const tag of book.tags) tagCounts.set(tag, (tagCounts.get(tag) ?? 0) + 1);
}
const topTags = [...tagCounts].sort(([a, aCount], [b, bCount]) =>
  bCount - aCount || a.localeCompare(b, 'ta')
).slice(0, 6).map(([tag]) => tag);
---

<div id="search-dialog-backdrop" class="fixed inset-0 z-50 bg-black/60 backdrop-blur-sm hidden items-start justify-center pt-16 sm:pt-24 px-4 overflow-y-auto" role="dialog" aria-modal="true" aria-label="நூல் தேடல்">
  <div id="search-dialog-box" class="relative w-full max-w-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] rounded-2xl shadow-2xl overflow-hidden">
    <div class="flex items-center px-4 py-3.5 border-b border-[var(--border-subtle)] bg-[var(--bg-page)]">
      <input type="search" id="search-input" aria-label="நூல், ஆசிரியர், வகை அல்லது பாடல் தேடுக" placeholder="நூல், ஆசிரியர், வகை, அதிகாரம், பாடல் தேடுக..." class="min-w-0 w-full bg-transparent text-[var(--text-main)] placeholder-[var(--text-dim)] text-base font-tamil-sans focus:outline-none" autocomplete="off" spellcheck="false" />
      <button type="button" id="search-close-btn" class="p-2 rounded-lg text-[var(--text-main)] hover:bg-[var(--bg-muted)]" aria-label="தேடலை மூடுக">✕</button>
    </div>
    <div class="px-4 py-2 border-b border-[var(--border-subtle)] flex items-center gap-2 overflow-x-auto text-xs font-tamil-sans">
      <span class="text-[var(--text-dim)] whitespace-nowrap">விரைவு வடிகட்டி:</span>
      {topTags.map((filter) => (
        <button type="button" class="search-filter-chip shrink-0 px-2.5 py-1 rounded-full bg-[var(--bg-muted)]" data-filter={filter}>{filter}</button>
      ))}
    </div>
    <p id="search-status" role="status" aria-live="polite" class="px-4 py-2 text-xs text-[var(--text-muted)]">நூல், ஆசிரியர், வகை அல்லது பாடலைத் தேடுக.</p>
    <div id="search-results" class="max-h-96 overflow-y-auto divide-y divide-[var(--border-subtle)]"></div>
    <div class="px-4 py-3 border-t border-[var(--border-subtle)]">
      <button type="button" id="search-more" class="hidden px-4 py-2 rounded-lg bg-[var(--accent-primary)] text-[var(--accent-contrast)]">மேலும் முடிவுகள்</button>
    </div>
  </div>
</div>

<script define:vars={{ indexUrl }}>
  const backdrop = document.getElementById('search-dialog-backdrop');
  const box = document.getElementById('search-dialog-box');
  const input = document.getElementById('search-input');
  const status = document.getElementById('search-status');
  const results = document.getElementById('search-results');
  const more = document.getElementById('search-more');
  const closeButton = document.getElementById('search-close-btn');
  let indexPromise;
  let matches = [];
  let shown = 0;
  let requestId = 0;
  let returnFocus;

  function normalize(value) {
    return value.normalize('NFC').toLocaleLowerCase().replace(/\s+/g, ' ').trim();
  }

  function loadIndex() {
    if (!indexPromise) {
      indexPromise = fetch(indexUrl).then((response) => {
        if (!response.ok) throw new Error(`Search index request failed: ${response.status}`);
        return response.json();
      }).catch((error) => {
        indexPromise = undefined;
        throw error;
      });
    }
    return indexPromise;
  }

  function openSearch() {
    if (!backdrop.classList.contains('hidden')) return;
    returnFocus = document.activeElement;
    backdrop.classList.remove('hidden');
    backdrop.classList.add('flex');
    input.focus();
  }

  function closeSearch() {
    backdrop.classList.add('hidden');
    backdrop.classList.remove('flex');
    if (returnFocus instanceof HTMLElement) returnFocus.focus();
  }

  window.addEventListener('open-search', openSearch);
  closeButton.addEventListener('click', closeSearch);
  backdrop.addEventListener('click', (event) => {
    if (event.target === backdrop) closeSearch();
  });
  window.addEventListener('keydown', (event) => {
    const open = !backdrop.classList.contains('hidden');
    if (event.key === 'Escape' && open) closeSearch();
    if (open && event.key === 'Tab') {
      const controls = [...box.querySelectorAll('input, button:not(.hidden), a[href]')].filter((element) => element.offsetParent !== null);
      if (event.shiftKey && document.activeElement === controls[0]) {
        event.preventDefault();
        controls[controls.length - 1].focus();
      } else if (!event.shiftKey && document.activeElement === controls[controls.length - 1]) {
        event.preventDefault();
        controls[0].focus();
      }
    }
    if ((event.key === '/' || ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k')) && !['INPUT', 'TEXTAREA', 'SELECT'].includes(document.activeElement?.tagName || '')) {
      event.preventDefault();
      openSearch();
    }
  });

  function appendResults() {
    const next = matches.slice(shown, shown + 15);
    for (const item of next) {
      const element = document.createElement(item.url ? 'a' : 'div');
      element.className = 'block p-4 font-tamil-sans';
      if (item.url) {
        element.href = item.url;
        element.classList.add('hover:bg-[var(--bg-surface-hover)]');
      }
      const title = document.createElement('div');
      title.className = 'font-tamil-serif font-bold text-base text-[var(--text-main)]';
      title.textContent = item.title;
      const metadata = document.createElement('p');
      metadata.className = 'text-xs text-[var(--text-muted)] mt-1';
      const kind = item.type === 'book' ? 'நூல்' : item.type === 'chapter' ? 'பகுதி' : 'பாடல் / உரை';
      metadata.textContent = [kind, item.author, item.url ? '' : 'விரைவில்'].filter(Boolean).join(' • ');
      const snippet = document.createElement('p');
      snippet.className = 'text-sm text-[var(--text-muted)] mt-1 [overflow-wrap:anywhere]';
      snippet.textContent = item.snippet;
      element.append(title, metadata, snippet);
      results.append(element);
    }
    shown += next.length;
    status.textContent = `${matches.length} முடிவுகள் • ${shown} காட்டப்படுகின்றன`;
    more.classList.toggle('hidden', shown >= matches.length);
  }

  async function performSearch() {
    const query = normalize(input.value);
    const currentRequest = ++requestId;
    results.replaceChildren();
    more.classList.add('hidden');
    if (!query) {
      status.textContent = 'நூல், ஆசிரியர், வகை அல்லது பாடலைத் தேடுக.';
      return;
    }
    status.textContent = 'தேடுகிறது...';
    try {
      const index = await loadIndex();
      if (currentRequest !== requestId) return;
      matches = index.filter((item) => item.searchable.some((field) => normalize(field).includes(query)));
      shown = 0;
      if (!matches.length) {
        status.textContent = 'முடிவுகள் இல்லை. வேறு சொல்லை முயற்சிக்கவும்.';
        return;
      }
      appendResults();
    } catch (error) {
      if (currentRequest !== requestId) return;
      console.error('Unable to load the search index', error);
      status.textContent = 'தேடல் குறியீட்டை ஏற்ற முடியவில்லை. மீண்டும் முயற்சிக்கவும்.';
    }
  }

  input.addEventListener('input', performSearch);
  more.addEventListener('click', appendResults);
  document.querySelectorAll('.search-filter-chip').forEach((chip) => {
    chip.addEventListener('click', () => {
      input.value = chip.getAttribute('data-filter') || '';
      input.focus();
      performSearch();
    });
  });
</script>
