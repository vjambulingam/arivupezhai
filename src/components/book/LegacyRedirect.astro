---
interface Props { target: string }
const { target } = Astro.props;
---

<!doctype html>
<html lang="ta">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>நூல் முகவரி மாற்றப்பட்டுள்ளது</title>
    <link rel="canonical" href={new URL(target, Astro.site).href} />
  </head>
  <body>
    <p>நூல் முகவரி மாற்றப்பட்டுள்ளது. <a href={target}>புதிய முகவரியில் வாசிக்கவும்</a>.</p>
    <script define:vars={{ target }}>
      location.replace(target + location.search + location.hash);
    </script>
  </body>
</html>
