---
import { getUrl } from '../utils/url.js';

const homeUrl = getUrl('/');
const thirukkuralUrl = getUrl('/book/thirukkural');
const palettesUrl = getUrl('/palettes');
const logoUrl = getUrl('arivupezhai-logo-sm.png');
---

<footer class="border-t border-[var(--border-subtle)] bg-[var(--bg-surface)] mt-16 transition-colors duration-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      
      <!-- Brand & Mission -->
      <div class="md:col-span-2 space-y-3">
        <div class="flex items-center gap-3">
          <div class="w-9 h-9 rounded-xl overflow-hidden shadow-xs border border-[var(--border-subtle)] shrink-0 bg-[var(--bg-page)]">
            <img src={logoUrl} alt="அறிவுப்பேழை" class="w-full h-full object-cover" width="36" height="36" loading="lazy" />
          </div>
          <span class="font-tamil-serif font-bold text-xl text-[var(--text-main)]">அறிவுப்பேழை</span>
        </div>
        <p class="font-tamil-sans text-sm text-[var(--text-muted)] leading-relaxed max-w-md">
          செவ்வியல் தமிழ் இலக்கியங்களை உலகெங்கும் வாழும் தமிழ் ஆர்வலர்கள், ஆய்வாளர்கள், மற்றும் வாசகர்கள் மொபைல் மற்றும் கணினிகளில் கண் சோர்வின்றி வாசிப்பதற்கான திறந்த டிஜிட்டல் நூலகம்.
        </p>
        <div class="pt-2 text-xs text-[var(--text-dim)] font-tamil-serif italic">
          "கற்க கசடறக் கற்பவை கற்றபின் நிற்க அதற்குத் தக"
        </div>
      </div>

      <!-- Quick Links -->
      <div class="space-y-3 font-tamil-sans">
        <h3 class="text-xs font-semibold text-[var(--text-main)] uppercase tracking-wider">
          முக்கியப் பக்கங்கள்
        </h3>
        <ul class="space-y-2 text-sm text-[var(--text-muted)]">
          <li>
            <a href={homeUrl} class="hover:text-[var(--accent-primary)] transition-colors">
              நூல் அட்டவணை (Library)
            </a>
          </li>
          <li>
            <a href={thirukkuralUrl} class="hover:text-[var(--accent-primary)] transition-colors">
              திருக்குறள் (Thirukkural)
            </a>
          </li>
          <li>
            <a href={palettesUrl} class="hover:text-[var(--accent-primary)] transition-colors">
              வண்ணத் தீம்கள் (Reading Themes)
            </a>
          </li>
        </ul>
      </div>

      <!-- Literary Sections -->
      <div class="space-y-3 font-tamil-sans">
        <h3 class="text-xs font-semibold text-[var(--text-main)] uppercase tracking-wider">
          இலக்கியப் பிரிவுகள்
        </h3>
        <ul class="space-y-2 text-sm text-[var(--text-muted)]">
          <li>
            <span class="text-[var(--text-main)] font-medium">பதினெண்கீழ்க்கணக்கு</span>
            <p class="text-xs text-[var(--text-dim)]">திருக்குறள், நாலடியார், முதலான அறநூல்கள்</p>
          </li>
          <li class="pt-1">
            <span class="text-[var(--text-main)] font-medium">ஐம்பெருங் காப்பியங்கள்</span>
            <p class="text-xs text-[var(--text-dim)]">சிலப்பதிகாரம், மணிமேகலை முதலானவை</p>
          </li>
          <li class="pt-1">
            <span class="text-[var(--text-main)] font-medium">தொல்காப்பியம் & இலக்கணம்</span>
            <p class="text-xs text-[var(--text-dim)]">எழுத்து, சொல், பொருள் இலக்கணக் கருவூலம்</p>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 mt-8 border-t border-[var(--border-subtle)] flex flex-col sm:flex-row items-center justify-between text-xs text-[var(--text-dim)] gap-4">
      <div class="flex items-center gap-2">
        <span>© {new Date().getFullYear()} அறிவுப்பேழை (Arivupezhai)</span>
        <span>•</span>
        <span>அனைத்து உரிமைகளும் பொதுக் களத்திற்கு உட்பட்டவை</span>
      </div>
      <div class="flex items-center gap-4">
        <a
          href="https://github.com/vjambulingam/arivupezhai"
          target="_blank"
          rel="noopener noreferrer"
          class="hover:text-[var(--text-main)] transition-colors flex items-center gap-1"
        >
          <span>GitHub</span>
          <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24">
            <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</footer>
