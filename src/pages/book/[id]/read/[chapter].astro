---
import Layout from '../../../../layouts/Layout.astro';
import { books } from '../../../../utils/books';
import { getUrl } from '../../../../utils/url.js';
import { chapterUrl } from '../../../../utils/reader.js';

export function getStaticPaths() {
  return books.flatMap((book) => book.sections.map((chapter) => ({
    params: { id: book.id, chapter: chapter.id },
    props: { book, chapter },
  })));
}

const { book, chapter } = Astro.props;
const index = book.sections.findIndex((section) => section.id === chapter.id);
const previous = index > 0 ? chapterUrl(book.id, book.sections[index - 1].id) : null;
const next = index < book.sections.length - 1 ? chapterUrl(book.id, book.sections[index + 1].id) : null;
---

<Layout title={`${chapter.title} • ${book.title_ta} • அறிவுப்பேழை`} description={`${book.title_ta}: ${chapter.title} • ${book.author_ta}`}>
  <noscript><style>#reader-athikaram-select, #reader-display-controls, .share-kural-btn, .copy-kural-btn { display: none; }</style></noscript>
  <div class="sticky top-18 z-30 w-full bg-[var(--bg-page)]/95 backdrop-blur-md border-b border-[var(--border-subtle)] shadow-xs">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-3 font-tamil-sans text-xs">
      <div class="flex items-center gap-2">
        <a href={getUrl(`book/${book.id}`)} class="p-1.5 rounded-lg border border-[var(--border-subtle)]" aria-label="நூல் விவரம்">←</a>
        <select id="reader-athikaram-select" aria-label="பகுதியைத் தேர்ந்தெடுக்கவும்" class="px-3 py-1.5 rounded-xl bg-[var(--bg-surface)] text-[var(--text-main)] border border-[var(--border-subtle)] max-w-[200px] sm:max-w-[280px]">
          {book.sections.map((item) => (
            <option value={chapterUrl(book.id, item.id)} selected={item.id === chapter.id}>{item.title}</option>
          ))}
        </select>
      </div>
      <div id="reader-display-controls" class="flex items-center gap-3">
        <select id="reader-font-select" aria-label="எழுத்துரு" class="hidden sm:inline-block px-2.5 py-1.5 rounded-xl bg-[var(--bg-surface)] text-[var(--text-main)] border border-[var(--border-subtle)]">
          <option value="font-tamil-serif">Noto Serif</option>
          <option value="font-tamil-malar">Mukta Malar</option>
          <option value="font-tamil-sans">Noto Sans</option>
        </select>
        <div class="flex items-center border border-[var(--border-subtle)] rounded-xl overflow-hidden bg-[var(--bg-surface)]">
          <button type="button" id="reader-size-dec" class="px-2.5 py-1" aria-label="எழுத்து அளவைக் குறைக்க">A-</button>
          <span id="reader-size-label" class="px-2 py-1 text-[11px] font-mono border-x border-[var(--border-subtle)]">100%</span>
          <button type="button" id="reader-size-inc" class="px-2.5 py-1" aria-label="எழுத்து அளவை அதிகரிக்க">A+</button>
        </div>
        <select id="reader-lh-select" aria-label="வரியிடைவெளி" class="hidden md:inline-block px-2 py-1.5 rounded-xl bg-[var(--bg-surface)] text-[var(--text-main)] border border-[var(--border-subtle)]">
          <option value="1.85">வரி: 1.85</option>
          <option value="2.0" selected>வரி: 2.0</option>
          <option value="2.2">வரி: 2.2</option>
        </select>
      </div>
    </div>
  </div>

  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    <header class="text-center space-y-3 pb-8 border-b border-[var(--border-subtle)]">
      {chapter.group && <p class="font-tamil-sans text-xs text-[var(--accent-primary)]">{chapter.group}</p>}
      <h1 class="font-tamil-serif font-bold text-3xl sm:text-4xl text-[var(--text-main)] tracking-tight leading-tight [overflow-wrap:anywhere]">{chapter.title}</h1>
      <p class="font-tamil-sans text-xs text-[var(--text-dim)]">{book.title_ta} • {book.author_ta}</p>
    </header>

    <div id="reader-verses-container" data-book={book.id} data-chapter={chapter.id} class="mt-10 space-y-8 font-tamil-serif transition-all" style="font-size: 1.25rem; line-height: 2.0;">
      {chapter.passages.map((passage) => (
        <article class="kural-card scroll-mt-48 p-6 sm:p-7 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] shadow-xs" id={passage.id || undefined}>
          <div class="flex items-center justify-between mb-4 font-tamil-sans text-xs">
            <span class="inline-flex px-3 py-1 rounded-full bg-[var(--accent-soft)] text-[var(--accent-primary)] font-bold">{passage.title || chapter.title}</span>
            <div class="flex items-center gap-1">
              <button type="button" class="share-kural-btn p-2 rounded-lg hover:bg-[var(--bg-muted)]" data-text={passage.copyText} data-anchor={passage.id} aria-label={`${passage.title || chapter.title} பகிர்`}>பகிர்</button>
              <button type="button" class="copy-kural-btn p-2 rounded-lg hover:bg-[var(--bg-muted)]" data-text={passage.copyText} aria-label={`${passage.title || chapter.title} நகலெடு`}>நகலெடு</button>
            </div>
          </div>
          <div class="tamil-verse-line tracking-wide text-[var(--text-main)] font-medium" set:html={passage.html} />
        </article>
      ))}
    </div>

    <nav aria-label="அதிகார வழிசெலுத்தல்" class="mt-16 pt-8 border-t border-[var(--border-subtle)] grid grid-cols-2 sm:flex items-center justify-between font-tamil-sans text-sm gap-3">
      {previous ? <a id="reader-prev-btn" href={previous} class="px-4 py-2.5 rounded-xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] text-center">← முந்தைய</a> : <span class="px-4 py-2.5 opacity-40 text-center">← முந்தைய</span>}
      <a href={getUrl(`book/${book.id}#athikarams-section`)} class="col-span-2 order-last sm:order-none px-3.5 py-2.5 rounded-xl bg-[var(--bg-muted)] border border-[var(--border-subtle)] text-center text-xs">அனைத்து பகுதிகள் ({book.sections.length})</a>
      {next ? <a id="reader-next-btn" href={next} class="px-4 py-2.5 rounded-xl bg-[var(--accent-primary)] text-[var(--accent-contrast)] text-center">அடுத்தது →</a> : <span class="px-4 py-2.5 opacity-40 text-center">அடுத்தது →</span>}
    </nav>
    <div id="copy-toast" role="status" class="fixed bottom-6 right-6 z-50 px-4 py-2 rounded-xl bg-[var(--text-main)] text-[var(--bg-page)] text-xs font-tamil-sans hidden"></div>
  </div>
</Layout>

<script>
  const chapterSelect = document.querySelector<HTMLSelectElement>('#reader-athikaram-select');
  chapterSelect?.addEventListener('change', () => { window.location.href = chapterSelect.value; });
  window.addEventListener('keydown', (event) => {
    if (['INPUT', 'SELECT', 'TEXTAREA'].includes(document.activeElement?.tagName || '') || document.querySelector('#search-dialog-backdrop:not(.hidden)')) return;
    const selector = event.key === 'ArrowLeft' ? '#reader-prev-btn' : event.key === 'ArrowRight' ? '#reader-next-btn' : null;
    if (!selector) return;
    const link = document.querySelector<HTMLAnchorElement>(selector);
    if (link) window.location.href = link.href;
  });

  const container = document.querySelector<HTMLElement>('#reader-verses-container');
  if (container?.dataset.book === 'thirukkural' && container.dataset.chapter) localStorage.setItem('arivupezhai_last_athikaram', container.dataset.chapter);
  const font = document.querySelector<HTMLSelectElement>('#reader-font-select');
  const lineHeight = document.querySelector<HTMLSelectElement>('#reader-lh-select');
  const sizeLabel = document.querySelector<HTMLElement>('#reader-size-label');
  const scales = [0.85, 0.95, 1, 1.15, 1.3, 1.45];
  let scaleIndex = Number(localStorage.getItem('arivupezhai_font_scale_index') ?? '2');
  if (!Number.isInteger(scaleIndex) || scaleIndex < 0 || scaleIndex >= scales.length) scaleIndex = 2;
  function applySize() {
    if (container && sizeLabel) {
      container.style.fontSize = `${1.25 * scales[scaleIndex]}rem`;
      sizeLabel.textContent = `${Math.round(scales[scaleIndex] * 100)}%`;
    }
  }
  applySize();
  for (const [id, delta] of [['reader-size-dec', -1], ['reader-size-inc', 1]] as const) {
    document.getElementById(id)?.addEventListener('click', () => {
      scaleIndex = Math.max(0, Math.min(scales.length - 1, scaleIndex + delta));
      applySize();
      localStorage.setItem('arivupezhai_font_scale_index', String(scaleIndex));
    });
  }
  function applyFont(value: string) {
    if (!container || !font || !['font-tamil-serif', 'font-tamil-malar', 'font-tamil-sans'].includes(value)) return;
    container.classList.remove('font-tamil-serif', 'font-tamil-malar', 'font-tamil-sans');
    container.classList.add(value);
    font.value = value;
  }
  applyFont(localStorage.getItem('arivupezhai_reader_font') || 'font-tamil-serif');
  font?.addEventListener('change', () => {
    applyFont(font.value);
    localStorage.setItem('arivupezhai_reader_font', font.value);
  });
  function applyLineHeight(value: string) {
    if (!container || !lineHeight || !['1.85', '2.0', '2.2'].includes(value)) return;
    container.style.setProperty('--reader-line-height', value);
    lineHeight.value = value;
  }
  applyLineHeight(localStorage.getItem('arivupezhai_reader_lh') || '2.0');
  lineHeight?.addEventListener('change', () => {
    applyLineHeight(lineHeight.value);
    localStorage.setItem('arivupezhai_reader_lh', lineHeight.value);
  });

  const toast = document.querySelector<HTMLElement>('#copy-toast');
  function showMessage(message: string) {
    if (!toast) return;
    toast.textContent = message;
    toast.classList.remove('hidden');
    setTimeout(() => toast.classList.add('hidden'), 2500);
  }
  document.querySelectorAll<HTMLButtonElement>('.copy-kural-btn, .share-kural-btn').forEach((button) => {
    button.addEventListener('click', async () => {
      const text = button.dataset.text || '';
      const url = `${location.origin}${location.pathname}${button.dataset.anchor ? `#${button.dataset.anchor}` : ''}`;
      try {
        if (button.classList.contains('share-kural-btn') && navigator.share) {
          await navigator.share({ title: document.title, text, url });
        } else {
          await navigator.clipboard.writeText(button.classList.contains('share-kural-btn') ? `${text}\n${url}` : text);
          showMessage('குறள் நகலெடுக்கப்பட்டது');
        }
      } catch (error) {
        if (error instanceof DOMException && error.name === 'AbortError') return;
        console.error('Unable to share or copy verse', error);
        showMessage('பகிரவோ நகலெடுக்கவோ முடியவில்லை.');
      }
    });
  });
</script>
