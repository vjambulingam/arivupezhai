---
import BookReader from '../../../../components/book/BookReader.astro';
import { books } from '../../../../utils/books';

export function getStaticPaths() {
  return books.flatMap((book) =>
    book.sections.map((section) => ({
      params: { id: book.slug, chapter: section.id },
      props: { book, section },
    }))
  );
}

const { book, section } = Astro.props;
---

<BookReader book={book} section={section} />
{(book.slug === 'thirukkural' || book.id === 'thirukkural') && (
  <script define:vars={{ chapterId: section.id }}>
    localStorage.setItem('arivupezhai_last_athikaram', chapterId);
  </script>
)}
