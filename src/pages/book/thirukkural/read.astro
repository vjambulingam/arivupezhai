---
import Layout from '../../../layouts/Layout.astro';
import thirukkuralData from '../../../data/books/thirukkural.json';
import { getUrl } from '../../../utils/url.js';

const book = thirukkuralData;
const bookLandingUrl = getUrl('book/thirukkural');
const homeUrl = getUrl('/');
---

<Layout
  title="திருக்குறள் வாசிப்புக் கூடம் • அறிவுப்பேழை"
  description="திருக்குறளின் 133 அதிகாரங்களையும் 1,330 குறட்பாக்களையும் கண் சோர்வின்றி வாசிப்பதற்கான நவீன வாசகர் தளம்."
>
  <!-- Sticky Reading Toolbar -->
  <div class="sticky top-18 z-30 w-full bg-[var(--bg-page)]/95 backdrop-blur-md border-b border-[var(--border-subtle)] shadow-xs transition-colors duration-200">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-3 font-tamil-sans text-xs">
      
      <!-- Left: Athikaram Dropdown -->
      <div class="flex items-center gap-2">
        <a
          href={bookLandingUrl}
          class="p-1.5 rounded-lg text-[var(--text-muted)] hover:text-[var(--text-main)] hover:bg-[var(--bg-surface)] transition-colors border border-[var(--border-subtle)]"
          title="நூல் விபரம் மற்றும் முழு அட்டவணை"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
        </a>

        <!-- Jump to Athikaram select -->
        <select
          id="reader-athikaram-select"
          class="px-3 py-1.5 rounded-xl bg-[var(--bg-surface)] text-[var(--text-main)] border border-[var(--border-subtle)] font-medium focus:outline-none focus:border-[var(--accent-primary)] max-w-[200px] sm:max-w-[280px] truncate"
        >
          {book.athikarams.map((a) => (
            <option value={a.number}>
              {a.number}. {a.name_ta} ({a.paal.name_ta})
            </option>
          ))}
        </select>
      </div>

      <!-- Right: Reader Display Controls -->
      <div class="flex items-center gap-3">
        
        <!-- Font Family Switch -->
        <select
          id="reader-font-select"
          class="hidden sm:inline-block px-2.5 py-1.5 rounded-xl bg-[var(--bg-surface)] text-[var(--text-main)] border border-[var(--border-subtle)] focus:outline-none"
          title="எழுத்துருவை மாற்றுக"
        >
          <option value="font-tamil-serif">Noto Serif</option>
          <option value="font-tamil-malar">Mukta Malar</option>
          <option value="font-tamil-sans">Noto Sans</option>
        </select>

        <!-- Font Size Adjuster -->
        <div class="flex items-center border border-[var(--border-subtle)] rounded-xl overflow-hidden bg-[var(--bg-surface)]">
          <button
            type="button"
            id="reader-size-dec"
            class="px-2.5 py-1 text-[var(--text-main)] hover:bg-[var(--bg-surface-hover)] transition-colors active:scale-95"
            title="எழுத்து அளவைக் குறைக்க (A-)"
          >
            A-
          </button>
          <span id="reader-size-label" class="px-2 py-1 text-[11px] font-mono text-[var(--text-dim)] border-x border-[var(--border-subtle)] bg-[var(--bg-muted)]">
            100%
          </span>
          <button
            type="button"
            id="reader-size-inc"
            class="px-2.5 py-1 text-[var(--text-main)] hover:bg-[var(--bg-surface-hover)] transition-colors active:scale-95"
            title="எழுத்து அளவை அதிகரிக்க (A+)"
          >
            A+
          </button>
        </div>

        <!-- Line Height Adjuster -->
        <select
          id="reader-lh-select"
          class="hidden md:inline-block px-2 py-1.5 rounded-xl bg-[var(--bg-surface)] text-[var(--text-main)] border border-[var(--border-subtle)] focus:outline-none"
          title="வரியிடைவெளி (Line Height)"
        >
          <option value="1.85">வரி: 1.85</option>
          <option value="2.0" selected>வரி: 2.0</option>
          <option value="2.2">வரி: 2.2</option>
        </select>

      </div>

    </div>
  </div>

  <!-- Reader Body Container -->
  <div class="max-w-3xl mx-auto px-4 sm:px-6 py-10 sm:py-14">
    
    <!-- Athikaram Header Banner -->
    <header class="text-center space-y-3 pb-8 border-b border-[var(--border-subtle)]">
      <div class="flex items-center justify-center gap-2 font-tamil-sans text-xs">
        <span id="reader-paal-badge" class="px-3 py-1 rounded-full bg-[var(--accent-soft)] text-[var(--accent-primary)] font-semibold border border-[var(--accent-primary)]/20">
          அறத்துப்பால்
        </span>
        <span id="reader-iyal-badge" class="px-3 py-1 rounded-full bg-[var(--badge-bg)] text-[var(--badge-text)]">
          பாயிரவியல்
        </span>
      </div>

      <h1 id="reader-athikaram-title" class="font-tamil-serif font-bold text-3xl sm:text-4xl text-[var(--text-main)] tracking-tight leading-tight">
        1. கடவுள் வாழ்த்து
      </h1>

      <p id="reader-kural-range" class="font-tamil-sans text-xs text-[var(--text-dim)]">
        குறள் 1 முதல் 10 வரை • திருவள்ளுவர்
      </p>
    </header>

    <!-- Verses Container -->
    <main
      id="reader-verses-container"
      class="mt-10 space-y-8 font-tamil-serif transition-all"
      style="font-size: 1.25rem; line-height: 2.0;"
    >
      <!-- Kurals rendered dynamically via JavaScript for zero page reloads -->
    </main>

    <!-- Bottom Navigation Bar (Prev / List / Next Athikaram) -->
    <footer class="mt-16 pt-8 border-t border-[var(--border-subtle)] flex items-center justify-between font-tamil-sans text-sm gap-3">
      <button
        type="button"
        id="reader-prev-btn"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-hover)] text-[var(--text-main)] border border-[var(--border-subtle)] transition-all active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
      >
        <span>←</span>
        <span class="hidden sm:inline">முந்தைய அதிகாரம்</span>
        <span class="sm:hidden">முந்தைய</span>
      </button>

      <a
        href={bookLandingUrl + '#athikarams-section'}
        class="px-3.5 py-2.5 rounded-xl bg-[var(--bg-muted)] hover:bg-[var(--bg-surface-hover)] text-[var(--text-muted)] text-xs font-medium border border-[var(--border-subtle)] transition-colors text-center"
      >
        அனைத்து அதிகாரங்கள் (133)
      </a>

      <button
        type="button"
        id="reader-next-btn"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[var(--accent-primary)] hover:bg-[var(--accent-hover)] text-[var(--accent-contrast)] font-semibold shadow-sm transition-all active:scale-95 disabled:opacity-40 disabled:cursor-not-allowed cursor-pointer"
      >
        <span class="hidden sm:inline">அடுத்த அதிகாரம்</span>
        <span class="sm:hidden">அடுத்தது</span>
        <span>→</span>
      </button>
    </footer>

    <!-- Reading Progress and Toast Feedback -->
    <div id="copy-toast" class="fixed bottom-6 right-6 z-50 px-4 py-2 rounded-xl bg-[var(--text-main)] text-[var(--bg-page)] text-xs font-tamil-sans font-medium shadow-lg transform translate-y-16 opacity-0 transition-all duration-300">
      குறள் நகலெடுக்கப்பட்டது (Copied to clipboard)
    </div>

  </div>
</Layout>

<script define:vars={{ athikaramsData: book.athikarams }}>
  // Reader State
  let currentAthikaramNum = 1;
  let fontScale = 1.0;
  const scales = [0.85, 0.95, 1.0, 1.15, 1.3, 1.45];
  let scaleIndex = 2; // default 1.0

  // DOM Elements
  const container = document.getElementById('reader-verses-container');
  const athikaramSelect = document.getElementById('reader-athikaram-select');
  const paalBadge = document.getElementById('reader-paal-badge');
  const iyalBadge = document.getElementById('reader-iyal-badge');
  const titleEl = document.getElementById('reader-athikaram-title');
  const rangeEl = document.getElementById('reader-kural-range');
  const prevBtn = document.getElementById('reader-prev-btn');
  const nextBtn = document.getElementById('reader-next-btn');

  const fontSelect = document.getElementById('reader-font-select');
  const lhSelect = document.getElementById('reader-lh-select');
  const sizeDec = document.getElementById('reader-size-dec');
  const sizeInc = document.getElementById('reader-size-inc');
  const sizeLabel = document.getElementById('reader-size-label');
  const toast = document.getElementById('copy-toast');

  // Parse URL parameter ?athikaram=N
  function getAthikaramFromUrl() {
    const params = new URLSearchParams(window.location.search);
    const num = parseInt(params.get('athikaram') || '1', 10);
    return isNaN(num) || num < 1 || num > 133 ? 1 : num;
  }

  // Toast notification
  function showToast(msg) {
    if (!toast) return;
    toast.textContent = msg;
    toast.classList.remove('translate-y-16', 'opacity-0');
    toast.classList.add('translate-y-0', 'opacity-100');
    setTimeout(() => {
      toast.classList.remove('translate-y-0', 'opacity-100');
      toast.classList.add('translate-y-16', 'opacity-0');
    }, 2200);
  }

  // Render the 10 kurals of current Athikaram
  function renderAthikaram(num) {
    const data = athikaramsData.find((a) => a.number === num);
    if (!data) return;

    currentAthikaramNum = num;

    // Update Header
    titleEl.textContent = `${data.number}. ${data.name_ta}`;
    paalBadge.textContent = data.paal.name_ta;
    iyalBadge.textContent = data.iyal;
    rangeEl.textContent = `குறள் ${data.start_kural} முதல் ${data.end_kural} வரை • திருவள்ளுவர்`;
    athikaramSelect.value = String(num);

    // Update Prev / Next buttons
    prevBtn.disabled = num <= 1;
    nextBtn.disabled = num >= 133;

    // Save last read position in localStorage
    localStorage.setItem('arivupezhai_last_athikaram', String(num));

    // Update URL without page reload
    const newUrl = new URL(window.location.href);
    newUrl.searchParams.set('athikaram', String(num));
    window.history.replaceState({ athikaram: num }, '', newUrl.toString());

    // Render 10 kurals
    const html = data.kurals.map((k) => `
      <article
        class="kural-card p-6 sm:p-7 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] shadow-xs hover:border-[var(--accent-primary)]/40 transition-all duration-200"
        id="kural-${k.number}"
      >
        <!-- Verse Top Meta -->
        <div class="flex items-center justify-between mb-4 font-tamil-sans text-xs">
          <span class="inline-flex items-center justify-center px-3 py-1 rounded-full bg-[var(--accent-soft)] text-[var(--accent-primary)] font-bold text-xs font-mono">
            குறள் ${k.number}
          </span>

          <div class="flex items-center gap-1">
            <!-- Share Button (Web Share API for WhatsApp/Social) -->
            <button
              type="button"
              class="share-kural-btn p-1.5 rounded-lg text-[var(--text-dim)] hover:text-[var(--accent-primary)] hover:bg-[var(--bg-muted)] transition-colors cursor-pointer"
              data-kural="${k.number}"
              data-text="${k.line1}\n${k.line2}\n\n— திருக்குறள் (${data.name_ta}, குறள் ${k.number})"
              title="பகிர் (Share on WhatsApp/Social)"
              aria-label="Share verse"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
              </svg>
            </button>

            <!-- Copy Button -->
            <button
              type="button"
              class="copy-kural-btn p-1.5 rounded-lg text-[var(--text-dim)] hover:text-[var(--accent-primary)] hover:bg-[var(--bg-muted)] transition-colors cursor-pointer"
              data-kural="${k.number}"
              data-text="${k.line1}\n${k.line2}"
              title="குறட்பாவை நகலெடு (Copy)"
              aria-label="Copy verse"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Couplet Text (Generous line height & padding to prevent diacritic clipping) -->
        <div class="tamil-verse-line tracking-wide text-[var(--text-main)] font-medium">
          <p class="select-text">${k.line1}</p>
          <p class="mt-1.5 select-text">${k.line2}</p>
        </div>
      </article>
    `).join('');

    container.innerHTML = html;

    // Attach Copy Handlers
    document.querySelectorAll('.copy-kural-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-text') || '';
        navigator.clipboard.writeText(text).then(() => {
          showToast('குறள் நகலெடுக்கப்பட்டது (Copied)');
        });
      });
    });

    // Attach Share Handlers (Web Share API)
    document.querySelectorAll('.share-kural-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const text = btn.getAttribute('data-text') || '';
        const kNum = btn.getAttribute('data-kural') || '';
        const shareUrl = `${window.location.origin}${window.location.pathname}?athikaram=${currentAthikaramNum}#kural-${kNum}`;
        if (navigator.share) {
          navigator.share({
            title: `திருக்குறள் - குறள் ${kNum}`,
            text: text,
            url: shareUrl
          }).catch(() => {});
        } else {
          navigator.clipboard.writeText(`${text}\n${shareUrl}`).then(() => {
            showToast('குறள் இணைப்புடன் நகலெடுக்கப்பட்டது (Copied with link)');
          });
        }
      });
    });

    // Smooth scroll to top of reading area
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  // Event Listeners for Navigation
  athikaramSelect.addEventListener('change', (e) => {
    const val = parseInt(e.target.value, 10);
    if (!isNaN(val)) renderAthikaram(val);
  });

  prevBtn.addEventListener('click', () => {
    if (currentAthikaramNum > 1) {
      renderAthikaram(currentAthikaramNum - 1);
    }
  });

  nextBtn.addEventListener('click', () => {
    if (currentAthikaramNum < 133) {
      renderAthikaram(currentAthikaramNum + 1);
    }
  });

  // Keyboard navigation: ArrowLeft for previous, ArrowRight for next
  window.addEventListener('keydown', (e) => {
    if (['INPUT', 'SELECT', 'TEXTAREA'].includes(document.activeElement?.tagName || '')) return;
    if (e.key === 'ArrowLeft' && currentAthikaramNum > 1) {
      renderAthikaram(currentAthikaramNum - 1);
    } else if (e.key === 'ArrowRight' && currentAthikaramNum < 133) {
      renderAthikaram(currentAthikaramNum + 1);
    }
  });

  // Reader Settings: Font Family
  if (fontSelect) {
    // Load saved font preference
    const savedFont = localStorage.getItem('arivupezhai_reader_font');
    if (savedFont) {
      fontSelect.value = savedFont;
      container.classList.remove('font-tamil-serif', 'font-tamil-malar', 'font-tamil-sans');
      container.classList.add(savedFont);
    }

    fontSelect.addEventListener('change', () => {
      const selected = fontSelect.value;
      container.classList.remove('font-tamil-serif', 'font-tamil-malar', 'font-tamil-sans');
      container.classList.add(selected);
      localStorage.setItem('arivupezhai_reader_font', selected);
    });
  }

  // Reader Settings: Line Height
  if (lhSelect) {
    const savedLh = localStorage.getItem('arivupezhai_reader_lh') || '2.0';
    lhSelect.value = savedLh;
    container.style.lineHeight = savedLh;

    lhSelect.addEventListener('change', () => {
      const lh = lhSelect.value;
      container.style.lineHeight = lh;
      localStorage.setItem('arivupezhai_reader_lh', lh);
    });
  }

  // Reader Settings: Font Size
  function applyFontScale() {
    const baseRem = 1.25;
    const currentRem = (baseRem * scales[scaleIndex]).toFixed(2);
    container.style.fontSize = `${currentRem}rem`;
    sizeLabel.textContent = `${Math.round(scales[scaleIndex] * 100)}%`;
    localStorage.setItem('arivupezhai_font_scale_index', String(scaleIndex));
  }

  const savedScaleIdx = localStorage.getItem('arivupezhai_font_scale_index');
  if (savedScaleIdx !== null) {
    scaleIndex = parseInt(savedScaleIdx, 10);
    if (isNaN(scaleIndex) || scaleIndex < 0 || scaleIndex >= scales.length) scaleIndex = 2;
    applyFontScale();
  }

  if (sizeDec && sizeInc) {
    sizeDec.addEventListener('click', () => {
      if (scaleIndex > 0) {
        scaleIndex--;
        applyFontScale();
      }
    });
    sizeInc.addEventListener('click', () => {
      if (scaleIndex < scales.length - 1) {
        scaleIndex++;
        applyFontScale();
      }
    });
  }

  // Initial load
  renderAthikaram(getAthikaramFromUrl());
</script>
