---
import Layout from '../../../layouts/Layout.astro';
import { books } from '../../../utils/books';
import { getUrl } from '../../../utils/url.js';
import { chapterUrl } from '../../../utils/reader.js';
const book = books.find((item) => item.slug === 'thirukkural' || item.id === 'thirukkural');
if (!book) throw new Error('Thirukkural content is missing');
---

<Layout title="திருக்குறள் வாசிப்புக் கூடம் • அறிவுப்பேழை">
  <div class="max-w-3xl mx-auto px-4 py-12 font-tamil-sans">
    <h1 class="font-tamil-serif text-3xl font-bold">திருக்குறள் அதிகாரங்கள்</h1>
    <p class="mt-4">வாசிக்க ஓர் அதிகாரத்தைத் தேர்ந்தெடுக்கவும்.</p>
    <p class="mt-3"><a class="text-[var(--accent-primary)] underline" href={getUrl('book/thirukkural')}>நூல் விவரம்</a></p>
    <ol class="mt-6 grid gap-2 sm:grid-cols-2">
      {book.sections.map((chapter) => (
        <li><a class="block p-3 rounded-xl bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-hover)]" href={chapterUrl(book.slug, chapter.id)}>{chapter.title}</a></li>
      ))}
    </ol>
  </div>
</Layout>
<script define:vars={{ readerBase: getUrl('book/thirukkural/read/') }}>
  const chapter = new URLSearchParams(location.search).get('athikaram');
  if (chapter && /^[0-9]+$/.test(chapter) && Number(chapter) >= 1 && Number(chapter) <= 133) {
    location.replace(`${readerBase}${Number(chapter)}/${location.hash}`);
  }
</script>
