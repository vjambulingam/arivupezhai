---
import BookLanding from '../../components/book/BookLanding.astro';
import { books } from '../../utils/books';

export function getStaticPaths() {
  return books.map((book) => ({
    params: { id: book.slug },
    props: { book },
  }));
}

const { book } = Astro.props;
---

<BookLanding book={book} />
