---
import Layout from '../layouts/Layout.astro';
import BookCard from '../components/BookCard.astro';
import { catalog as libraryData } from '../utils/books';
import { getUrl } from '../utils/url.js';

const logoUrl = getUrl('arivupezhai-logo-transparent.png');
const availableBooks = libraryData.filter((book) => book.is_available);
---

<Layout
  title="அறிவுப்பேழை • செவ்வியல் தமிழ் இணைய நூலகம்"
  description="செவ்வியல் தமிழ் இலக்கியங்களை வசதியாக வாசிப்பதற்காக வடிவமைக்கப்பட்ட நவீன இணைய நூலகம். திருக்குறள் உள்ளிட்ட சங்க இலக்கியக் கருவூலங்கள்."
>
  <!-- Hero Section -->
  <section class="relative pt-8 pb-12 sm:pt-12 sm:pb-16 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    
    <!-- Hero Logo & Tagline pill -->
    <div class="flex items-center justify-center mb-6">
      <div class="inline-flex items-center gap-2.5 px-4 py-2 rounded-2xl bg-[var(--bg-surface)] border border-[var(--border-subtle)] shadow-sm text-xs font-tamil-sans text-[var(--text-muted)]">
        <img src={logoUrl} alt="அறிவுப்பேழை" class="h-6 w-auto object-contain" />
        <span class="font-semibold text-[var(--text-main)]">அறிவுப்பேழை</span>
        <span class="text-[var(--text-dim)]">•</span>
        <span>செவ்வியல் தமிழ் இணைய நூலகம்</span>
      </div>
    </div>

    <!-- Main Title -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <h1 class="font-tamil-serif font-bold text-4xl sm:text-5xl md:text-6xl text-[var(--text-main)] tracking-tight leading-tight">
        செவ்வியல் தமிழ் இலக்கியப் பேழை
      </h1>
      <p class="font-tamil-sans text-base sm:text-lg text-[var(--text-muted)] leading-relaxed max-w-2xl mx-auto">
        பண்டைய தமிழ்ச் சுவடிகளையும் செவ்வியல் காப்பியங்களையும் நவீன திரைகளில் வசதியாக வாசிப்பதற்கென வடிவமைக்கப்பட்ட மின்னூலகம்.
      </p>
    </div>

  </section>

  <!-- Books Catalog Grid Section -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pb-20">
    
    <!-- Filter Tabs -->
    <div class="flex items-center justify-between border-b border-[var(--border-subtle)] pb-4 mb-8">
      <div>
        <h2 class="font-tamil-serif font-bold text-2xl text-[var(--text-main)]">
          நூலகம் (Library)
        </h2>
        <p class="font-tamil-sans text-xs text-[var(--text-muted)] mt-1">
          செவ்வியல் நூல்களைத் தேர்ந்தெடுத்து வாசிக்கவும்.
        </p>
      </div>
      
      <!-- Filter buttons (client-side toggle) -->
      <div class="hidden md:flex flex-wrap items-center gap-1.5 font-tamil-sans text-xs">
        <button type="button" class="genre-btn active px-3 py-1.5 rounded-lg bg-[var(--accent-primary)] text-[var(--accent-contrast)] font-medium shadow-sm" data-genre="all">
          அனைத்தும் ({availableBooks.length})
        </button>
        {[...new Set(availableBooks.map((book) => book.genre_ta).filter(Boolean))].map((genre) => (
          <button type="button" class="genre-btn px-3 py-1.5 rounded-lg bg-[var(--bg-surface)] hover:bg-[var(--bg-surface-hover)] text-[var(--text-muted)] border border-[var(--border-subtle)]" data-genre={genre}>{genre}</button>
        ))}
      </div>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="books-grid">
      {availableBooks.map((book) => (
        <div class="book-item min-w-0" data-genre={book.genre_ta}>
          <BookCard book={book} />
        </div>
      ))}
    </div>

  </section>
</Layout>

<script>
  // Genre tabs filtering
  const genreBtns = document.querySelectorAll('.genre-btn');
  const bookItems = document.querySelectorAll('.book-item');

  genreBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      genreBtns.forEach((b) => {
        b.classList.remove('active', 'bg-[var(--accent-primary)]', 'text-[var(--accent-contrast)]');
        b.classList.add('bg-[var(--bg-surface)]', 'text-[var(--text-muted)]');
      });
      btn.classList.add('active', 'bg-[var(--accent-primary)]', 'text-[var(--accent-contrast)]');
      btn.classList.remove('bg-[var(--bg-surface)]', 'text-[var(--text-muted)]');

      const target = btn.getAttribute('data-genre');
      bookItems.forEach((item) => {
        if (target === 'all' || item.getAttribute('data-genre') === target) {
          (item as HTMLElement).style.display = 'block';
        } else {
          (item as HTMLElement).style.display = 'none';
        }
      });
    });
  });
</script>
